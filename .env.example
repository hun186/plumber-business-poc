# Without these three values, the app launches in local-browser demo mode.
# Never commit the filled .env file or production credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
APP_ADMIN_PASSWORD=SET_A_LONG_UNIQUE_ADMIN_PASSWORD
AUTH_SECRET=SET_A_RANDOM_32_BYTE_OR_LONGER_SECRET
